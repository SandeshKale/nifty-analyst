{
  "name": "nifty-analyst",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint api/ --quiet",
    "test": "node tests/analyze.test.mjs",
    "check": "bash scripts/check-all.sh",
    "precommit": "npm run check",
    "format": "prettier --write api/ src/",
    "format:check": "prettier --check api/ src/",
    "lint:fix": "eslint api/ --fix",
    "server": "node server.js",
    "server:watch": "node --watch server.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "vite": "^5.4.8"
  },
  "type": "module"
}
